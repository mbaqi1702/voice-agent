# ===========================================
# Voice Agent - Environment Variables
# ===========================================
# Copy this file to .env and fill in your keys
# All services below have free tiers suitable for personal use

# ----- LLM (choose one) -----
# Recommended free: Groq
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Alternative: OpenAI-compatible (OpenRouter, Together, Fireworks, etc.)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# ----- STT (choose one) -----
ASSEMBLYAI_API_KEY=your_assemblyai_key_here
# DEEPGRAM_API_KEY=your_deepgram_key_here
STT_PROVIDER=assemblyai          # assemblyai | deepgram | faster-whisper

# ----- TTS -----
# edge-tts is free and requires no key
TTS_PROVIDER=edge                # edge | browser | piper
TTS_VOICE=en-US-AriaNeural       # see edge-tts voice list

# ----- Supabase (optional but recommended) -----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ----- Server -----
HOST=0.0.0.0
PORT=7860
DEBUG=true

# ----- Paths -----
DOCUMENTS_DIR=./data/documents
VECTOR_STORE_DIR=./data/vector_store
